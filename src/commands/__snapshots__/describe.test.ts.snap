exports[`buildOpenclawManifest matches the snapshot 1`] = `
{
  "bin": "oura-cli",
  "commands": [
    {
      "description": "Fetch raw records for one Oura collection straight from the API (JSON).",
      "examples": [
        "oura-cli fetch sleep",
        "oura-cli fetch hr --days 7",
        "oura-cli fetch workout --from 2026-05-01 --to 2026-05-31",
      ],
      "name": "fetch",
    },
    {
      "description": "Query and manage the local SQLite database",
      "examples": [
        "oura-cli db today",
        "oura-cli db week --format json",
      ],
      "name": "db",
    },
    {
      "description": "Generate a narrative health report from local data.",
      "examples": [
        "oura-cli report --period week",
      ],
      "name": "report",
    },
    {
      "description": "Diagnose token, database, and sync health, and suggest the next step.",
      "examples": [
        "oura-cli doctor --offline",
      ],
      "name": "doctor",
    },
    {
      "description": "Save a token.",
      "examples": [
        "oura-cli login",
      ],
      "name": "login",
    },
  ],
  "description": "Oura Ring CLI — query and analyze Oura Ring health data. Designed for humans and agents.",
  "envVars": [
    "OURA_TOKEN",
    "OURA_TOKEN_PATH",
    "OURA_DB_PATH",
    "OURA_TZ",
  ],
  "healthcheck": {
    "command": "healthcheck",
    "expects": {
      "error": "string, present only when ok is false",
      "latencyMs": "number",
      "ok": "boolean",
      "version": "string",
    },
  },
  "id": "oura-cli",
  "runtime": "bun",
  "version": "9.9.9",
}
`;
